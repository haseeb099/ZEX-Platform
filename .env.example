# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dev:dev@localhost:5434/twenty_automation
DATABASE_LOGGING=false
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6380
REDIS_DB=0

# Encryption (64-char hex = 32 bytes)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Twenty (global defaults; per-tenant keys stored encrypted in DB)
TWENTY_GRAPHQL_URL=https://api.twenty.com/graphql

# Enrichment Providers
CLEARBIT_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=

# Observability
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Feature Flags
FEATURE_AUTO_OPPORTUNITY=true
FEATURE_BATCH_SCORING=false
FEATURE_DEAL_HEALTH=false

# Rate Limiting
WEBHOOK_RATE_LIMIT=1000
ENRICHMENT_RATE_LIMIT=5000

# Admin API (bootstrap)
ADMIN_API_KEY=dev-admin-api-key-change-in-production
