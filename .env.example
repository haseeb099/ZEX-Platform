# Runtime
# development | test | staging | production
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dev:dev@localhost:5434/zex_platform
DATABASE_LOGGING=false
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6380
REDIS_DB=0

# Encryption
# Exactly 64 hexadecimal characters (32 bytes). Generate a unique secret for each environment.
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT
# Use a unique high-entropy value per environment (minimum 32 characters).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Twenty CRM defaults
# Per-tenant credentials are stored encrypted. This URL is only the fallback/default.
TWENTY_GRAPHQL_URL=https://api.twenty.com/graphql

# Enrichment providers
CLEARBIT_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=

# Observability
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Feature flags
FEATURE_AUTO_OPPORTUNITY=true
FEATURE_BATCH_SCORING=false
FEATURE_DEAL_HEALTH=false

# Rate limiting
WEBHOOK_RATE_LIMIT=1000
ENRICHMENT_RATE_LIMIT=5000

# Bootstrap admin API
# Minimum 32 characters. Use a randomly generated high-entropy secret outside local development.
ADMIN_API_KEY=dev-admin-api-key-change-this-32chars-min
