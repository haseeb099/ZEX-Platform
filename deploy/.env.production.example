# =============================================================================
# ZEX-Platform production environment contract (PLACEHOLDERS ONLY)
# Copy to a private secret store / host path — NEVER commit real values.
# File name suggestion on hosts: .env.production (gitignored)
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Immutable release provenance (set at deploy time) ---
# Must match the image tag / git SHA being promoted. Never use "latest".
ZEX_RELEASE_SHA=REPLACE_WITH_GIT_SHA
ZEX_PLATFORM_IMAGE=ghcr.io/REPLACE_ORG/zex-platform:REPLACE_WITH_GIT_SHA

# --- Postgres (managed/external preferred) ---
# Include TLS params as required by your provider, e.g. ?sslmode=require
DATABASE_URL=postgresql://zex_app:REPLACE_PASSWORD@REPLACE_HOST:5432/zex_platform?sslmode=require
DATABASE_LOGGING=false
# Application-level flag (docs); connection TLS is controlled via DATABASE_URL params.
DATABASE_SSL=true

# --- Redis (managed/external preferred; queue/cache — not canonical business DB) ---
# Use a dedicated instance or DB index per environment. Never share prod/staging.
REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:6379/0
REDIS_DB=0

# --- Encryption (AES-256-GCM for tenant secrets at rest) ---
# Exactly 64 hex chars (32 bytes). UNIQUE per environment.
# ROTATING MASTER_KEY without a re-encryption migration will break decryption of
# stored TwentyConnection API keys / webhook secrets. Plan rotation carefully.
MASTER_KEY=REPLACE_WITH_64_HEX_CHARS_UNIQUE_TO_PRODUCTION

# --- Auth / admin ---
# UNIQUE high-entropy secrets per environment (min lengths enforced at boot).
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_API_KEY_AT_LEAST_32_CHARS
SDR_REPLY_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_16_CHARS

# --- Safety defaults (do not relax in production) ---
ALLOW_TWENTY_SNAPSHOT_FALLBACK=false
STAGING_DETERMINISTIC_ENRICHMENT=false
COMPANY_BRAIN_DETERMINISTIC=false
PROSPECT_DISCOVERY_DETERMINISTIC=false
WHY_NOW_DETERMINISTIC=false
RESEARCH_AGENT_DETERMINISTIC=false
AI_SDR_DETERMINISTIC=false

# --- Feature flags ---
FEATURE_AUTO_OPPORTUNITY=true
FEATURE_BATCH_SCORING=false

# --- Optional enrichment providers (leave empty if unused) ---
CLEARBIT_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
OPENAI_API_KEY=

# --- Optional observability ---
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Optional smoke (read-only) ---
# When set, production smoke may call workspace→tenant resolution and agent overview.
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_WORKSPACE_ID=
SMOKE_TENANT_ID=
# Must match ADMIN_API_KEY for smoke; inject via secret store, do not bake into image.
SMOKE_ADMIN_API_KEY=

# --- Backup / restore tooling (ops host; not required inside app container) ---
# BACKUP_DIR=/var/backups/zex-platform
# PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE may be used by pg_dump/pg_restore
# instead of embedding passwords in shell history. Prefer .pgpass or secret files.
