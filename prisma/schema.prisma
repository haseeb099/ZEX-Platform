generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  /// @deprecated Prefer TwentyConnection.workspaceId — kept for staged migration.
  twentyWorkspaceId    String
  /// @deprecated Prefer TwentyConnection.apiKey — kept for staged migration.
  twentyApiKey         String    @db.Text
  /// @deprecated Prefer TwentyConnection.webhookSecret — kept for staged migration.
  twentyWebhookSecret  String
  scoringRules         ScoringRule[]
  enableAutoOpportunity Boolean  @default(true)
  opportunityThreshold Int       @default(60)
  enableEnrichment     Boolean   @default(true)
  enrichmentProviders  String[]  @default(["clearbit", "apollo", "hunter"])
  enrichmentRequestsPerMonth Int @default(5000)
  webhookRateLimit     Int       @default(1000)
  plan                 String    @default("starter")
  status               String    @default("active")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  webhookLogs          WebhookLog[]
  auditLogs            AuditLog[]
  scoreHistory         ScoreHistory[]
  twentyConnection     TwentyConnection?
  companyBrains        CompanyBrain[]
  prospectDiscoveryRuns ProspectDiscoveryRun[]
  prospectResearchRuns  ProspectResearchRun[]
  sdrSequences          SdrSequence[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

/// Per-tenant Twenty CRM deployment connection (1:1 with Tenant for v1).
/// ZEX-Platform owns connection config; Twenty/ZEX-CRM owns operational CRM truth.
model TwentyConnection {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId     String
  baseUrl         String
  graphqlUrl      String
  restUrl         String
  apiKey          String    @db.Text
  webhookSecret   String    @db.Text
  twentyVersion   String?
  status          String    @default("active")
  lastVerifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model ScoringRule {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rules       Json
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([enabled])
}

model ScoreHistory {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personTwentyId      String
  personName          String?
  personEmail         String?
  score               Int
  factors             Json
  ruleName            String?
  opportunityCreated  Boolean  @default(false)
  opportunityTwentyId String?
  createdAt           DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([personTwentyId])
}

model EnrichmentProvider {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  clearbitApiKey        String?
  apolloApiKey          String?
  hunterApiKey          String?
  requestsUsedThisMonth Int      @default(0)
  lastResetDate         DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
}

model EnrichedPerson {
  id             String   @id @default(cuid())
  tenantId       String
  personTwentyId String
  personEmail    String?
  companyName    String?
  companyDomain  String?
  companySize    String?
  industry       String?
  location       String?
  jobTitle       String?
  jobFunction    String?
  technologies   String[] @default([])
  source         String?
  confidence     Int      @default(100)
  enrichedAt     DateTime @default(now())

  @@unique([tenantId, personTwentyId])
  @@index([tenantId, personEmail])
}

model WebhookLog {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event       String
  payload     Json
  status      String    @default("queued")
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRetryAt DateTime?
  jobId       String?
  jobResult   Json?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([tenantId, status])
  @@index([event])
  @@index([createdAt])
}

model AuditLog {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action           String
  resourceType     String?
  resourceTwentyId String?
  before           Json?
  after            Json?
  triggeredBy      String
  webhookLogId     String?
  success          Boolean  @default(true)
  message          String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
  @@index([resourceTwentyId])
}

model JobResult {
  id          String    @id @default(cuid())
  tenantId    String
  jobType     String
  jobId       String
  status      String    @default("processing")
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([tenantId, jobType])
  @@index([status])
}

/// Canonical Company Brain aggregate (ZEX-Platform intelligence). Not coupled to Twenty schemas.
model CompanyBrain {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName      String
  websiteUrl       String?
  /// draft | analyzing | ready | failed
  status           String   @default("draft")
  version          Int      @default(1)
  /// Last validated AI-generated structured payload (provenance snapshot).
  generatedPayload Json?
  /// Effective editable payload returned to clients (human overrides applied).
  payload          Json?
  /// Section/item keys protected from regeneration overwrite.
  userOverrides    Json?
  lastAnalyzedAt   DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sources          CompanyBrainSource[]
  analysisJobs     CompanyBrainAnalysisJob[]

  @@index([tenantId, updatedAt])
  @@index([tenantId, status])
}

/// Ingested evidence sources for a Company Brain. Deduped by contentHash per brain.
model CompanyBrainSource {
  id             String       @id @default(cuid())
  tenantId       String
  companyBrainId String
  companyBrain   CompanyBrain @relation(fields: [companyBrainId], references: [id], onDelete: Cascade)
  /// WEBSITE | URL | PASTED_TEXT | DOCUMENT_TEXT
  sourceType     String
  sourceUrl      String?
  title          String?
  rawText        String       @db.Text
  contentHash    String
  fetchedAt      DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@unique([companyBrainId, contentHash])
  @@index([tenantId, companyBrainId])
}

/// Durable analysis job status for async Company Brain generation.
model CompanyBrainAnalysisJob {
  id             String       @id @default(cuid())
  tenantId       String
  companyBrainId String
  companyBrain   CompanyBrain @relation(fields: [companyBrainId], references: [id], onDelete: Cascade)
  bullJobId      String?
  /// queued | processing | completed | failed
  status         String       @default("queued")
  error          String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([tenantId, companyBrainId])
  @@index([status])
}

/// Prospect Discovery run driven by a Company Brain (ZEX-Platform owned until approval).
model ProspectDiscoveryRun {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyBrainId String
  /// queued | processing | completed | failed
  status         String   @default("queued")
  provider       String?
  error          String?
  requestedAt    DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  candidates     ProspectCandidate[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([companyBrainId])
}

/// Proposed prospect company — Platform-owned until explicitly approved for CRM write.
model ProspectCandidate {
  id                     String               @id @default(cuid())
  tenantId               String
  discoveryRunId         String
  discoveryRun           ProspectDiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  providerKey            String?
  companyName            String
  domain                 String?
  websiteUrl             String?
  industry               String?
  companySize            String?
  geography              String?
  description            String?
  fitScore               Int                  @default(0)
  fitBand                String               @default("unknown")
  fitReasons             Json?
  disqualifiers          Json?
  /// PROPOSED | DUPLICATE | APPROVED | REJECTED | CREATED | FAILED
  status                 String               @default("PROPOSED")
  /// NEW | EXACT_MATCH | POSSIBLE_MATCH
  dedupeStatus           String               @default("NEW")
  existingTwentyCompanyId String?
  createdTwentyCompanyId  String?
  evidence               Json?
  buyerRoles             Json?
  lastError              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  signals                ProspectSignal[]
  scoreSnapshots         ProspectScoreSnapshot[]
  researchRuns           ProspectResearchRun[]
  researchFindings       ProspectResearchFinding[]
  sdrSequences           SdrSequence[]

  @@index([tenantId, discoveryRunId])
  @@index([tenantId, status])
  @@index([domain])
}

/// Typed intent/timing signal for Why-Now scoring (Platform-owned, provenance-backed).
model ProspectSignal {
  id                   String            @id @default(cuid())
  tenantId             String
  prospectCandidateId  String
  prospectCandidate    ProspectCandidate @relation(fields: [prospectCandidateId], references: [id], onDelete: Cascade)
  signalType           String
  category             String
  title                String
  summary              String?
  source               String
  sourceUrl            String?
  occurredAt           DateTime
  observedAt           DateTime          @default(now())
  /// 0–1 source confidence
  confidence           Float             @default(0.5)
  /// 0–1 relevance to ICP / product
  relevance            Float             @default(0.5)
  evidence             Json?
  providerKey          String?
  /// Stable idempotency key (tenant+candidate+type+source+occurredAt+content)
  dedupeKey            String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, prospectCandidateId])
  @@index([tenantId, signalType])
  @@index([occurredAt])
}

/// Immutable Why-Now score snapshot — rescoring appends; history retained.
model ProspectScoreSnapshot {
  id                   String            @id @default(cuid())
  tenantId             String
  prospectCandidateId  String
  prospectCandidate    ProspectCandidate @relation(fields: [prospectCandidateId], references: [id], onDelete: Cascade)
  fitScore             Int
  intentScore          Int
  timingScore          Int
  overallScore         Int
  /// 0–1 confidence (distinct from overallScore)
  confidence           Float
  whyNow               String
  fitReasons           Json?
  intentReasons        Json?
  timingReasons        Json?
  signalIds            Json?
  scoringVersion       String            @default("why-now-v1")
  createdAt            DateTime          @default(now())

  @@index([tenantId, prospectCandidateId, createdAt])
  @@index([tenantId, createdAt])
}

/// Research Agent run — Platform-owned; never writes CRM (ZEX-35).
model ProspectResearchRun {
  id                   String                   @id @default(cuid())
  tenantId             String
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospectCandidateId  String
  prospectCandidate    ProspectCandidate        @relation(fields: [prospectCandidateId], references: [id], onDelete: Cascade)
  /// QUEUED | PROCESSING | COMPLETED | FAILED | BLOCKED
  status               String                   @default("QUEUED")
  provider             String?
  requestedAt          DateTime                 @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  error                String?
  triggeredBy          String?
  researchVersion      String                   @default("research-agent-v1")
  /// Structured research package snapshot (self-contained history)
  package              Json?
  confidence           Float?
  whyNowSnapshotId     String?
  findingCount         Int                      @default(0)
  fixture              String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  findings             ProspectResearchFinding[]

  @@index([tenantId, prospectCandidateId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// Source-backed research finding — provenance required; deduped across runs.
model ProspectResearchFinding {
  id                   String              @id @default(cuid())
  tenantId             String
  researchRunId        String
  researchRun          ProspectResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  prospectCandidateId  String
  prospectCandidate    ProspectCandidate   @relation(fields: [prospectCandidateId], references: [id], onDelete: Cascade)
  findingType          String
  title                String
  summary              String
  claim                String
  sourceUrl            String?
  sourceTitle          String?
  sourceType           String?
  excerpt              String?
  occurredAt           DateTime?
  publishedAt          DateTime?
  observedAt           DateTime            @default(now())
  confidence           Float               @default(0.5)
  relevance            Float               @default(0.5)
  /// EXPLICIT | INFERRED
  evidenceType         String              @default("EXPLICIT")
  /// Optional named person — only when source explicitly supports it
  personName           String?
  personRole           String?
  stale                Boolean             @default(false)
  providerKey          String?
  dedupeKey            String
  createdAt            DateTime            @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, prospectCandidateId])
  @@index([tenantId, researchRunId])
  @@index([tenantId, findingType])
}

/// AI SDR outreach sequence — Platform-owned; approval-first send (ZEX-36).
model SdrSequence {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospectCandidateId  String
  prospectCandidate    ProspectCandidate @relation(fields: [prospectCandidateId], references: [id], onDelete: Cascade)
  researchRunId        String?
  whyNowSnapshotId     String?
  /// DRAFTING | AWAITING_APPROVAL | APPROVED | ACTIVE | PAUSED | REPLIED | COMPLETED | CANCELLED | FAILED
  status               String   @default("DRAFTING")
  channel              String   @default("email")
  /// Explicit recipient — never guessed from names/domains
  targetEmail          String?
  targetPersonTwentyId String?
  targetPersonName     String?
  /// NONE | PENDING | COMPLETED | FAILED
  crmSyncStatus        String   @default("NONE")
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  drafts               SdrDraft[]
  approvals            SdrApproval[]
  messages             SdrMessage[]
  replies              SdrReply[]
  meetingBookings      SdrMeetingBooking[]

  @@index([tenantId, prospectCandidateId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// Versioned outreach draft — never overwrite; supersede instead.
model SdrDraft {
  id                   String   @id @default(cuid())
  tenantId             String
  sequenceId           String
  sequence             SdrSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  prospectCandidateId  String
  version              Int
  channel              String   @default("email")
  /// outreach | follow_up | reply | meeting
  purpose              String   @default("outreach")
  subject              String?
  body                 String
  evidenceRefs         Json?
  researchFindingIds   Json?
  whyNowSnapshotId     String?
  doNotClaimApplied    Json?
  grounding            Json?
  confidence           Float    @default(0.5)
  /// DRAFT | AWAITING_APPROVAL | APPROVED | SUPERSEDED | SENT | REJECTED
  status               String   @default("DRAFT")
  contentHash          String
  generatedAt          DateTime @default(now())
  supersededAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  approvals            SdrApproval[]
  messages             SdrMessage[]

  @@unique([sequenceId, version])
  @@index([tenantId, sequenceId])
  @@index([tenantId, prospectCandidateId])
  @@index([tenantId, contentHash])
}

/// Human approval bound to exact draft id + contentHash + version.
model SdrApproval {
  id          String    @id @default(cuid())
  tenantId    String
  sequenceId  String
  sequence    SdrSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  draftId     String
  draft       SdrDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftVersion Int
  contentHash String
  approvedBy  String
  approvedAt  DateTime  @default(now())
  /// ACTIVE | REVOKED
  status      String    @default("ACTIVE")
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  messages    SdrMessage[]

  @@index([tenantId, draftId])
  @@index([tenantId, sequenceId])
  @@index([tenantId, status])
}

/// Durable outbound send attempt — strongly idempotent.
model SdrMessage {
  id                String    @id @default(cuid())
  tenantId          String
  sequenceId        String
  sequence          SdrSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  draftId           String
  draft             SdrDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  approvalId        String
  approval          SdrApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  channel           String    @default("email")
  provider          String?
  providerMessageId String?
  idempotencyKey    String
  /// QUEUED | SENDING | SENT | FAILED
  status            String    @default("QUEUED")
  sentAt            DateTime?
  failedAt          DateTime?
  error             String?
  /// NONE | PENDING | COMPLETED | FAILED
  crmSyncStatus     String    @default("NONE")
  crmSyncError      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  replies           SdrReply[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sequenceId])
  @@index([tenantId, draftId])
  @@index([tenantId, providerMessageId])
  @@index([tenantId, status])
}

/// Inbound reply correlated to sequence/message.
model SdrReply {
  id              String   @id @default(cuid())
  tenantId        String
  sequenceId      String
  sequence        SdrSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messageId       String?
  message         SdrMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  providerEventId String
  /// POSITIVE | NEGATIVE | QUESTION | NOT_NOW | OOO | UNSUBSCRIBE | UNKNOWN
  classification  String   @default("UNKNOWN")
  sender          String?
  subject         String?
  bodySummary     String?
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([tenantId, providerEventId])
  @@index([tenantId, sequenceId])
  @@index([tenantId, messageId])
}

/// Deterministic meeting booking workflow (no silent calendar booking).
model SdrMeetingBooking {
  id                   String    @id @default(cuid())
  tenantId             String
  sequenceId           String
  sequence             SdrSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  prospectCandidateId  String
  /// PROPOSED | AWAITING_APPROVAL | SENT | BOOKED | CANCELLED
  status               String    @default("PROPOSED")
  bookingLink          String?
  providerMeetingId    String?
  schedulingDraftId    String?
  proposedTimes        Json?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, sequenceId])
  @@index([tenantId, status])
}

/// Persistent CRM write checkpoints for enrich-and-score job retries.
/// Scoped per tenant + webhookLogId + action — never reused across events or tenants.
model JobActionCheckpoint {
  id             String   @id @default(cuid())
  tenantId       String
  webhookLogId   String
  personTwentyId String
  action         String
  externalId     String?
  status         String   @default("completed")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, webhookLogId, action])
  @@index([tenantId, webhookLogId])
  @@index([personTwentyId])
}
